{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awen scoring knowledge v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "sources",
    "sceneAliases",
    "genreAliases",
    "sceneFunctions",
    "genres",
    "harmonicFamilies",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "awen-scoring-knowledge"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "kind",
          "reviewed",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "sceneAliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "genreAliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sceneFunctions": {
      "type": "object",
      "minProperties": 1
    },
    "genres": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "evidenceStatus",
          "sourceIds",
          "sceneChoices"
        ],
        "properties": {
          "evidenceStatus": {
            "const": "awen-proposal"
          },
          "sceneChoices": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "harmonicFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidenceStatus",
          "sourceIds",
          "sourceScope",
          "chords",
          "form",
          "harmonicBars"
        ],
        "properties": {
          "evidenceStatus": {
            "const": "awen-proposal"
          },
          "harmonicBars": {
            "enum": [
              1,
              2,
              4
            ]
          },
          "form": {
            "type": "array",
            "minItems": 4,
            "maxItems": 16,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "chords": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "root",
                "intervals",
                "quality"
              ],
              "properties": {
                "root": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "intervals": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "contains": {
                    "const": 0
                  },
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  }
                }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "voices",
        "midiMin",
        "midiMax",
        "minVoiceGap",
        "transition",
        "automaticSceneSelection",
        "exactProgressionsAreOriginal",
        "readingBenefitEstablished"
      ],
      "properties": {
        "voices": {
          "const": 4
        },
        "midiMin": {
          "const": 55
        },
        "midiMax": {
          "const": 79
        },
        "minVoiceGap": {
          "const": 3
        },
        "transition": {
          "const": "four-bar-phrase"
        },
        "automaticSceneSelection": {
          "const": false
        },
        "exactProgressionsAreOriginal": {
          "const": true
        },
        "readingBenefitEstablished": {
          "const": false
        }
      }
    }
  }
}
