  "sources": [
    {
      "id": "lehman-2013",
      "title": "Transformational Analysis and the Representation of Genius in Film Music",
      "url": "https://franklehman.com/wp-content/uploads/2020/02/MTS-Article.pdf",
      "kind": "original-analysis",
      "reviewed": "Abstract and opening discussion, pp. 1-2",
      "summary": "Analyses context-sensitive triadic chromaticism and warns against interpreting pitch relations apart from editing, spotting and narrative."
    },
    {
      "id": "lee-2025",
      "title": "The Semantic Evolution of Chromatic Mediants",
      "url": "https://www.mtosmt.org/issues/mto.25.31.2/mto.25.31.2.lee_jason.html",
      "kind": "original-analysis",
      "reviewed": "Abstract and introduction [0.1]-[0.3]",
      "summary": "Treats mediant associations as historically conventional; its film example shows magical harmony supporting comic mockery."
    },
    {
      "id": "lehman-2018-excerpt",
      "title": "Hollywood Harmony, chapter 3 excerpt",
      "url": "https://music.arts.uci.edu/abauer/3.1/notes/Frank_Lehman_Hollywood_Harmony_Chapter_3_%282018%29.pdf",
      "kind": "original-analysis",
      "reviewed": "Indexed excerpt: Tritonal Transposition; full book not reviewed",
      "summary": "Discusses cinematic uses of same-mode triads with roots a tritone apart, with distinctions between uncanny threat and cosmic spectacle."
    },
    {
      "id": "giacchino-2020",
      "title": "Song of the West: Scoring Let Him Go",
      "url": "https://www.focusfeatures.com/article/interview_let-him-go-composer_michael_giacchino",
      "kind": "composer-account",
      "reviewed": "Q&A: genre, internal character experience, instrumentation",
      "summary": "A western also calls for thriller and family-drama treatments; sparse forces and character needs shape the score."
    },
    {
      "id": "houston-theatre",
      "title": "Interview with Chris Houston",
      "url": "https://www.marintheatre.org/press-release-details/239/interview-with-sound-designer-composer-and-musical-director-chris-houston-web-exclusive",
      "kind": "composer-account",
      "reviewed": "Questions on composition, script spotting and underscoring",
      "summary": "Describes reducing melody around theatrical speech and adapting music to script, period and production; this is one practitioner account."
    },
    {
      "id": "sutton-curious",
      "title": "The Curious Incident of the Dog in the Night-time",
      "url": "https://www.adriansutton.com/works/AS0016/",
      "kind": "composer-account",
      "reviewed": "Composer work note",
      "summary": "Derives musical material and electronic timbre from the protagonist and production concept rather than a generic dramatic label."
    },
    {
      "id": "berklee-genres",
      "title": "Music Composition for Film and TV 1",
      "url": "https://online.berklee.edu/courses/music-composition-for-film-and-tv",
      "kind": "teaching-outline",
      "reviewed": "Public course description; lessons not accessed",
      "summary": "Organises genre study across melody, harmony, rhythm, tempo and orchestration, rather than a single chord dictionary."
    },
    {
      "id": "williams-kraken",
      "title": "Interview: The Kraken Wakes: Alan Williams",
      "url": "https://scifibulletin.com/books/audiobooks/dangerous-visions/dangerous-visions-interview-the-kraken-wakes-alan-williams/",
      "kind": "composer-account",
      "reviewed": "Sections on thematic treatment, scale and dialogue balance",
      "summary": "Discusses intimate and large-scale layers, recurring material and the practical balance of orchestra with radio drama."
    },
    {
      "id": "morricone-2006",
      "title": "Ennio Morricone interviewed in 2006",
      "url": "https://www.bfi.org.uk/sight-and-sound/interviews/if-you-want-call-yourself-composer-you-follow-every-step-instrumentation-ennio-morricone-interviewed-2006",
      "kind": "composer-account",
      "reviewed": "Script, orchestration and sound-design questions",
      "summary": "Describes script-led musical direction and instrumental strands, distinguishing his music work from other sound design."
    }
